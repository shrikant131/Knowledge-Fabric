[Unit]
Description=Knowledge Fabric
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/knowledge-fabric
EnvironmentFile=/etc/knowledge-fabric.env
ExecStart=/opt/knowledge-fabric/.venv/bin/gunicorn -c /opt/knowledge-fabric/gunicorn.conf.py admin.app:app
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/knowledge-fabric/data /opt/knowledge-fabric/connectors_registry

[Install]
WantedBy=multi-user.target
