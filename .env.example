# Knowledge Fabric
KF_HOST=127.0.0.1
KF_PORT=5050
KF_DATA_DIR=./data
KF_AUTO_BOOTSTRAP=1

# LLM
KF_LLM_PROVIDER=local
KF_LLM_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=
AWS_REGION=
BEDROCK_MODEL_ID=

# Web security
# Local: none. Cloud/simple protected control plane: api_key.
KF_AUTH_MODE=none
ADMIN_API_KEY=
SECRET_KEY=
KF_COOKIE_SECURE=0
KF_PUBLIC_PLAYGROUND=1

# Limits
KF_MAX_UPLOAD_BYTES=26214400
KF_RATE_LIMIT=60
KF_BENCHMARK_RATE_LIMIT=10

# Optional shared rate limiting for multi-instance deployments
KF_RATE_BACKEND=local
KF_REDIS_URL=

# Background jobs
KF_ASYNC_JOBS=0
KF_JOB_WORKERS=2
